{
  "name": "@msameim181/iran-map-vue",
  "version": "0.1.0",
  "description": "Lightweight interactive SVG map of Iran for Vue 3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "import": "./dist/full.js",
      "require": "./dist/full.cjs"
    },
    "./style.css": "./dist/style.css",
    "./styles.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Msameim181/iran-map-vue.git"
  },
  "homepage": "https://msameim181.github.io/iran-map-vue/",
  "bugs": {
    "url": "https://github.com/Msameim181/iran-map-vue/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "map",
    "iran",
    "iran-map",
    "svg-map",
    "choropleth",
    "vue",
    "vue3"
  ],
  "author": "Msameim181",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p example/tsconfig.json",
    "demo": "vite --config example/vite.config.ts",
    "demo:build": "vite build --config example/vite.config.ts",
    "lint": "eslint \"{src,tests,example}/**/*.{js,ts,vue}\" \"*.{js,ts}\"",
    "prettier": "prettier --write \"{src,tests,example/src}/**/*.{js,ts,vue,css}\"",
    "format:check": "prettier --check \"{src,tests,example/src}/**/*.{js,ts,vue,css}\"",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm test && npm run lint && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.0.0"
  },
  "dependencies": {
    "@msameim181/iran-map-core": "file:../iran-map-core"
  }
}
