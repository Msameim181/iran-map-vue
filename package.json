{
  "name": "@msameim181/iran-map-vue",
  "version": "0.2.2",
  "description": "Vue 3 SVG map of Iran with provinces, counties, capitals, Persian names, choropleth colors, and typed selection events.",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./full": {
      "import": {
        "types": "./dist/types/full.d.ts",
        "default": "./dist/esm/full.js"
      },
      "require": {
        "types": "./dist/cjs/full.d.cts",
        "default": "./dist/cjs/full.cjs"
      }
    },
    "./lite": {
      "import": {
        "types": "./dist/types/lite.d.ts",
        "default": "./dist/esm/lite.js"
      },
      "require": {
        "types": "./dist/cjs/lite.d.cts",
        "default": "./dist/cjs/lite.cjs"
      }
    },
    "./score-bands": {
      "import": {
        "types": "./dist/types/score-bands.d.ts",
        "default": "./dist/esm/score-bands.js"
      },
      "require": {
        "types": "./dist/cjs/score-bands.d.cts",
        "default": "./dist/cjs/score-bands.cjs"
      }
    },
    "./create": {
      "import": {
        "types": "./dist/types/create.d.ts",
        "default": "./dist/esm/create.js"
      },
      "require": {
        "types": "./dist/cjs/create.d.cts",
        "default": "./dist/cjs/create.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./styles.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Msameim181/iran-map-vue.git"
  },
  "homepage": "https://msameim181.github.io/iran-map-vue/",
  "bugs": {
    "url": "https://github.com/Msameim181/iran-map-vue/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "iran",
    "iran-map",
    "persian",
    "farsi",
    "svg-map",
    "geojson",
    "provinces",
    "counties",
    "choropleth",
    "map",
    "typescript",
    "vue",
    "vue3",
    "vue-component"
  ],
  "author": "Msameim181",
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && vite build && npm run build:types && node scripts/post-build.mjs",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p example/tsconfig.json",
    "demo": "vite --config example/vite.config.ts",
    "demo:build": "vite build --config example/vite.config.ts",
    "lint": "eslint \"{src,tests,example}/**/*.{js,ts,vue}\" \"*.{js,ts}\"",
    "prettier": "prettier --write \"{src,tests,example/src}/**/*.{js,ts,vue,css}\"",
    "format:check": "prettier --check \"{src,tests,example/src}/**/*.{js,ts,vue,css}\"",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm test && npm run lint && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:types": "tsc -p tsconfig.build.json && node scripts/build-types.js",
    "check:package": "publint --strict && attw --pack . --exclude-entrypoints ./style.css ./styles.css",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "publint": "0.3.25",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.0"
  },
  "dependencies": {
    "@msameim181/iran-map-core": "^0.2.0"
  },
  "typesVersions": {
    "*": {
      "full": [
        "./dist/types/full.d.ts"
      ],
      "lite": [
        "./dist/types/lite.d.ts"
      ],
      "score-bands": [
        "./dist/types/score-bands.d.ts"
      ],
      "create": [
        "./dist/types/create.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  }
}
